<section class="sv7 sv7-cta" aria-labelledby="sv7-c-{{ section.id }}">
  {%- if section.settings.image_left != blank -%}<img class="side side--l" src="{{ section.settings.image_left | asset_url }}" alt="" width="544" height="359" loading="lazy">{%- endif -%}
  {%- if section.settings.image_right != blank -%}<img class="side side--r" src="{{ section.settings.image_right | asset_url }}" alt="" width="544" height="359" loading="lazy">{%- endif -%}
  <div class="sv7-wrap sv7-cta-in">
    <h2 id="sv7-c-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="sv7-lead">{{ section.settings.text }}</p>{%- endif -%}
    <div class="sv7-actions is-center">
      {%- if section.settings.btn_1 != blank -%}<a class="sv7-btn" href="{{ section.settings.btn_1_url }}">{{ section.settings.btn_1 }}{% render 'sv7-icon', name: 'arrow' %}</a>{%- endif -%}
      {%- if section.settings.btn_2 != blank -%}<a class="sv7-btn sv7-btn--ghost" href="{{ section.settings.btn_2_url }}">{{ section.settings.btn_2 }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Somnila v7 · Closing band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next 30 nights start here." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_1", "label": "Button 1", "default": "Shop the pillows" },
    { "type": "url", "id": "btn_1_url", "label": "Button 1 link" },
    { "type": "text", "id": "btn_2", "label": "Button 2", "default": "Read the FAQ" },
    { "type": "url", "id": "btn_2_url", "label": "Button 2 link" },
    { "type": "text", "id": "image_left", "label": "Left picture (theme asset file name)", "default": "sv6-cut-neck-01-sky.webp" },
    { "type": "text", "id": "image_right", "label": "Right picture (theme asset file name)", "default": "sv6-cut-neck-01-stone.webp" }
  ],
  "presets": [ { "name": "Somnila v7 · Closing band" } ]
}
{% endschema %}
