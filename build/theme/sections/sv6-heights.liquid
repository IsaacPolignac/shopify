{%- liquid
  assign sv6_hide = false
  if section.settings.only_for_handle != blank and product != blank and product.handle != section.settings.only_for_handle
    assign sv6_hide = true
  endif
-%}
{%- unless sv6_hide -%}
<section class="sv6 sv6-heights{% if section.settings.tint %} sv6-tint{% endif %}" aria-labelledby="sv6-h-{{ section.id }}">
  <div class="sv6-wrap sv6-sec sv6-edge">
    <figure class="sv6-fig" data-state="side"><svg viewBox="-110 20 1020 320" role="img" aria-label="Side view of Neck 01: 62 centimetres long, one edge 13 centimetres high, the other 11. Turning it over swaps which edge sits under the neck."><g class="pw"><path d="M90 270 L90 158 Q90 140 108 140 C214 140 290 172 400 172 C520 172 586 160 692 160 Q710 160 710 178 L710 270 Z" fill="#DCE8F2" stroke="#1E2A3A" stroke-width="2"/><path d="M104 262 L104 162 Q104 152 114 152 C214 152 290 184 400 184 C520 184 586 172 690 172" fill="none" stroke="#FFFFFF" stroke-width="3" opacity=".7"/></g><line x1="-110" x2="910" y1="270" y2="270" stroke="#1E2A3A" stroke-width="2"/><g class="la"><line x1="62" x2="62" y1="140" y2="270" stroke="#556676" stroke-width="1.5"/><line x1="54" x2="70" y1="140" y2="140" stroke="#556676" stroke-width="1.5"/><text x="48" y="208" text-anchor="end" font-size="24" font-weight="700" fill="#1E2A3A">13 cm</text><text x="48" y="232" text-anchor="end" class="t2" font-size="18" fill="#556676">5.1 in</text><line x1="738" x2="738" y1="160" y2="270" stroke="#556676" stroke-width="1.5"/><line x1="730" x2="746" y1="160" y2="160" stroke="#556676" stroke-width="1.5"/><text x="752" y="218" font-size="24" font-weight="700" fill="#1E2A3A">11 cm</text><text x="752" y="242" class="t2" font-size="18" fill="#556676">4.3 in</text><line x1="132" x2="132" y1="134" y2="84" stroke="#1E2A3A" stroke-width="1.5"/><circle cx="132" cy="140" r="8" fill="#F0B79B" stroke="#1E2A3A" stroke-width="2"/><text x="120" y="72" font-size="20" font-weight="700" fill="#1E2A3A">Under your neck</text></g><g class="lb"><line x1="62" x2="62" y1="160" y2="270" stroke="#556676" stroke-width="1.5"/><line x1="54" x2="70" y1="160" y2="160" stroke="#556676" stroke-width="1.5"/><text x="48" y="218" text-anchor="end" font-size="24" font-weight="700" fill="#1E2A3A">11 cm</text><text x="48" y="242" text-anchor="end" class="t2" font-size="18" fill="#556676">4.3 in</text><line x1="738" x2="738" y1="140" y2="270" stroke="#556676" stroke-width="1.5"/><line x1="730" x2="746" y1="140" y2="140" stroke="#556676" stroke-width="1.5"/><text x="752" y="208" font-size="24" font-weight="700" fill="#1E2A3A">13 cm</text><text x="752" y="232" class="t2" font-size="18" fill="#556676">5.1 in</text><line x1="132" x2="132" y1="154" y2="104" stroke="#1E2A3A" stroke-width="1.5"/><circle cx="132" cy="160" r="8" fill="#F0B79B" stroke="#1E2A3A" stroke-width="2"/><text x="120" y="92" font-size="20" font-weight="700" fill="#1E2A3A">Under your neck</text></g><g transform="translate(560 40)"><rect x="0" y="0" width="200" height="40" rx="20" fill="#FFFFFF" stroke="#1E2A3A" stroke-width="2"/><line x1="86" x2="86" y1="8" y2="32" stroke="#1E2A3A" stroke-width="1.5"/><line x1="114" x2="114" y1="8" y2="32" stroke="#1E2A3A" stroke-width="1.5"/><circle class="bub" cx="100" cy="20" r="11" fill="#F0B79B"/><g class="lvl"><text x="100" y="66" text-anchor="middle" font-size="18" font-weight="700" fill="#1E2A3A">Level</text></g></g><line x1="90" x2="710" y1="300" y2="300" stroke="#556676" stroke-width="1.5"/><line x1="90" x2="90" y1="292" y2="308" stroke="#556676" stroke-width="1.5"/><line x1="710" x2="710" y1="292" y2="308" stroke="#556676" stroke-width="1.5"/><text x="400" y="330" text-anchor="middle" font-size="20" fill="#1E2A3A"><tspan font-weight="700">62 cm</tspan> · 24.4 in</text></svg><figcaption>{{ section.settings.caption }}</figcaption></figure>
    <div style="display:grid;gap:18px">
      {%- if section.settings.kick != blank -%}<p class="sv6-kick">{{ section.settings.kick }}</p>{%- endif -%}
      <h2 id="sv6-h-{{ section.id }}">{{ section.settings.heading }}</h2>
      <div class="sv6-pick" role="group" aria-label="Show a sleeping position">
        <button type="button" data-sv6-edge="side" aria-pressed="true"><span class="big num">13 cm</span><span class="lab">{{ section.settings.side_label }}<small>{{ section.settings.side_small }}</small></span>{% render 'sv6-icon', name: 'arrow' %}</button>
        <button type="button" data-sv6-edge="back" aria-pressed="false"><span class="big num">11 cm</span><span class="lab">{{ section.settings.back_label }}<small>{{ section.settings.back_small }}</small></span>{% render 'sv6-icon', name: 'arrow' %}</button>
      </div>
      {%- if section.settings.note != blank -%}<p class="sv6-sub" style="font-size:15.5px">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Somnila · Two heights",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kick", "label": "Small title", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two heights. Turn it over." },
    { "type": "text", "id": "side_label", "label": "Side label", "default": "On your side" },
    { "type": "text", "id": "side_small", "label": "Side detail", "default": "Higher edge under your neck" },
    { "type": "text", "id": "back_label", "label": "Back label", "default": "On your back" },
    { "type": "text", "id": "back_small", "label": "Back detail", "default": "Lower edge under your neck" },
    { "type": "text", "id": "note", "label": "Note", "default": "Keep the edge where your head lies level." },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Side view of Neck 01, to scale. The curve between the edges is a sketch." },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "text", "id": "only_for_handle", "label": "On product pages, show only for this product handle", "default": "neck-01" }
  ],
  "presets": [ { "name": "Somnila · Two heights" } ]
}
{% endschema %}
