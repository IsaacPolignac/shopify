{%- assign fp = section.settings.product -%}
<section class="sv6" aria-labelledby="sv6-h-{{ section.id }}">
  <div class="sv6-wrap sv6-sec" style="padding-top:0">
    <div class="sv6-final">
      <div class="sv6-stage">
        {%- if section.settings.image_asset != blank -%}
          <div class="sv6-flt"><div class="sv6-bob"><img src="{{ section.settings.image_asset | asset_url }}" alt="{{ fp.title | escape }}" width="546" height="374" loading="lazy"></div><div class="sv6-shadow"></div></div>
        {%- endif -%}
      </div>
      <div style="display:grid;gap:16px;justify-items:start">
        <h2 id="sv6-h-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="sv6-sub">{{ section.settings.text }}</p>{%- endif -%}
        {%- if fp != blank -%}
          <span class="sv6-price num" style="font-size:30px">{{ fp.price | money }}</span>
          <a class="sv6-btn" href="{{ fp.url }}">{{ section.settings.button_label }} {% render 'sv6-icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Somnila · Last call",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still deciding?" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Neck 01" },
    { "type": "text", "id": "image_asset", "label": "Theme image file", "default": "sv6-cut-neck-01-night.webp" }
  ],
  "presets": [ { "name": "Somnila · Last call" } ]
}
{% endschema %}
