{%- comment -%} Sets band (PurePeptide "Stocking up?"): every saving is computed from the real prices of the pieces. {%- endcomment -%}
{%- liquid
  assign ex = section.settings.example
  assign ex_sep = 0
  if ex != blank and section.settings.example_components != blank
    capture s
      render 'sv6-separately', components: section.settings.example_components
    endcapture
    assign ex_sep = s | strip | plus: 0
  endif
  assign ex_save = ex_sep | minus: ex.price
-%}
<section class="sv7 sv7-sec sv7-volume" aria-labelledby="sv7-v-{{ section.id }}">
  <div class="sv7-wrap sv7-volume-in">
    {%- if section.settings.pill != blank -%}<p class="sv7-pill">{{ section.settings.pill }}</p>{%- endif -%}
    <h2 id="sv7-v-{{ section.id }}">{{ section.settings.heading }} <span class="hl">{{ section.settings.heading_hl }}</span></h2>
    {%- if section.settings.text != blank -%}<p class="sv7-lead">{{ section.settings.text }}</p>{%- endif -%}
    <ul class="sv7-vchips">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bp = block.settings.product
          assign pct = 0
          if bp != blank and block.settings.components != blank
            capture s
              render 'sv6-separately', components: block.settings.components
            endcapture
            assign sep = s | strip | plus: 0
            assign save = sep | minus: bp.price
            if save > 0 and sep > 0
              assign pct = save | times: 100.0 | divided_by: sep | round
            endif
          endif
        -%}
        <li class="{% if forloop.first %}is-dark{% elsif bp != blank %}is-soft{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}{% if pct > 0 %} · Save {{ pct }}%{% endif %}</li>
      {%- endfor -%}
    </ul>
    {%- if ex != blank -%}
      <a class="sv7-line" href="{{ ex.url }}">
        <span class="im">{%- if section.settings.example_image != blank -%}<img src="{{ section.settings.example_image | asset_url }}" alt="" width="120" height="120" loading="lazy">{%- else -%}{{ ex.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}{%- if section.settings.example_count != blank -%}<em class="num">{{ section.settings.example_count }}</em>{%- endif -%}</span>
        <span class="tx"><b>{{ ex.title | split: ' — ' | first }}</b><small>{{ ex.title | split: ' — ' | last }}</small>{% if ex_save > 0 %}<span class="sv7-okpill">{% render 'sv7-icon', name: 'check' %}Set price</span>{% endif %}</span>
        <span class="pr">{% if ex_save > 0 %}<s class="num">{{ ex_sep | money }}</s>{% endif %}<b class="num">{{ ex.price | money }}</b>{% if ex_save > 0 %}<small class="num">Save {{ ex_save | money }}</small>{% endif %}</span>
      </a>
    {%- endif -%}
    {%- if section.settings.btn != blank -%}<a class="sv7-btn" href="{{ section.settings.btn_url }}">{{ section.settings.btn }}</a>{%- endif -%}
    {%- if section.settings.note != blank -%}<p class="sv7-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Somnila v7 · Sets band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "pill", "label": "Pill", "default": "Sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleeping in pairs?" },
    { "type": "text", "id": "heading_hl", "label": "Heading, highlighted end", "default": "Save on the set." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product", "id": "example", "label": "Example set" },
    { "type": "text", "id": "example_components", "label": "Example set bought separately", "info": "e.g. neck-01*3" },
    { "type": "text", "id": "example_image", "label": "Example picture (theme asset file name)" },
    { "type": "text", "id": "example_count", "label": "Count badge", "default": "×3" },
    { "type": "text", "id": "btn", "label": "Button", "default": "Shop the sets" },
    { "type": "url", "id": "btn_url", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note", "default": "No code needed. The set price already includes the saving." }
  ],
  "blocks": [
    { "type": "chip", "name": "Chip", "limit": 4, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "2 pillows" },
      { "type": "product", "id": "product", "label": "Set (optional, adds the real saving)" },
      { "type": "text", "id": "components", "label": "Set bought separately", "info": "e.g. neck-01*2" } ] }
  ],
  "presets": [ { "name": "Somnila v7 · Sets band" } ]
}
{% endschema %}
