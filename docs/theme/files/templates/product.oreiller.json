    "attendre": {
      "type": "multicolumn",
      "blocks": {
        "c1": {
          "type": "column",
          "settings": {
            "title": "Nuits 1 à 3 · Trouver sa position",
            "text": "<p>La forme contourée ne ressemble pas à un oreiller plat. Votre corps cherche où se poser. La plupart des gens trouvent leur position dès la deuxième nuit.</p>"
          }
        },
        "c2": {
          "type": "column",
          "settings": {
            "title": "Semaine 1 · Le sommeil s'installe",
            "text": "<p>Vous vous endormez plus vite et vous restez endormi plus longtemps. Les matins changent : vous vous levez reposé, pas seulement debout.</p>"
          }
        },
        "c3": {
          "type": "column",
          "settings": {
            "title": "Semaines 2 et 3 · Ça devient naturel",
            "text": "<p>Vous ne pensez plus à l'oreiller. Il fait partie du lit. C'est le moment où on cesse de remarquer ce qui fonctionne.</p>"
          }
        },
        "c4": {
          "type": "column",
          "settings": {
            "title": "Nuit 30 · La décision",
            "text": "<p>Vous savez si c'est le bon. Si ce n'est pas le cas, la garantie court toujours et nous reprenons l'oreiller.</p>"
          }
        }
      },
      "block_order": [
